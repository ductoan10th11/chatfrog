# Copy thành .env (chmod 600). Xem docs/SPEC.md §9.

API_PORT=9260

# MongoDB Atlas (Atlas → Connect → Drivers). Tên db lấy từ path, mặc định "chatfrog".
# Network Access của Atlas phải cho phép IP của VPS.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.<id>.mongodb.net/chatfrog?retryWrites=true&w=majority

# Model server (OpenAI-compatible). Hai profile CLOUD_ và LOCAL_, mỗi profile có thể có 1 LLM + 1 model ảnh.
# Cài đặt > Hệ thống: tại một thời điểm chỉ 1 LLM và 1 model ảnh được bật (mặc định: cloud trước).
CLOUD_BASE_URL=http://127.0.0.1:9220/v1
CLOUD_API_KEY=
CLOUD_LLM_MODEL=qwen3.8-flash:plan
CLOUD_LLM_CONTEXT_TOKENS=1000000
CLOUD_LLM_MAX_OUTPUT_TOKENS=131072
CLOUD_LLM_VISION=true
CLOUD_VISION_MAX_PX=1024
CLOUD_IMAGE_MODEL=qwen-image-3.0-pro:plan
CLOUD_IMAGE_MAX_CONCURRENCY=1
CLOUD_IMAGE_TIMEOUT=180s

LOCAL_BASE_URL=http://gpu-box:9099/v1
LOCAL_API_KEY=
LOCAL_LLM_MODEL=qwen-3.6-35b-a3b:5090
LOCAL_LLM_CONTEXT_TOKENS=32768
LOCAL_LLM_MAX_OUTPUT_TOKENS=4096
LOCAL_LLM_VISION=true
LOCAL_VISION_MAX_PX=1024
LOCAL_IMAGE_MODEL=qwen-image-2.1:5090
LOCAL_IMAGE_MAX_CONCURRENCY=1
LOCAL_IMAGE_TIMEOUT=180s

# Google OAuth. GG_CALLBACK_URL phải trùng "Authorized redirect URI" trong Google Cloud Console;
# APP_ORIGIN mặc định lấy theo origin của URL này.
GG_CALLBACK_URL=https://chat.naot.me/auth/gg/callback
GG_CLIENT_ID=
GG_CLIENT_SECRET=

# Email (cách nhau bằng dấu phẩy): ADMIN_EMAILS → admin + active ngay; ALLOWED_EMAILS → active ngay.
ADMIN_EMAILS=
ALLOWED_EMAILS=

# Tuỳ chọn (giá trị mặc định)
# APP_ORIGIN=https://chat.naot.me
# SESSION_TTL=720h
# LLM_REASONING_EFFORT=low          # none = tắt thinking
# LLM_MAX_CONCURRENCY=2
# MAX_UPLOAD_MB=20
# DOC_MAX_CHARS=24000
# MAX_MESSAGE_CHARS=16000
# STATS_TZ=Asia/Ho_Chi_Minh
