# Copy thành .env (chmod 600). Xem docs/SPEC.md §9.

API_PORT=9260

# MongoDB Atlas (Atlas → Connect → Drivers). Tên db lấy từ path, mặc định "chatfrog".
# Network Access của Atlas phải cho phép IP của VPS.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.<id>.mongodb.net/chatfrog?retryWrites=true&w=majority

# Model server (OpenAI-compatible, qua Tailscale). Dùng chung cho LLM và ảnh;
# muốn tách thì đặt LLM_BASE_URL / LLM_API_KEY / IMAGE_BASE_URL / IMAGE_API_KEY.
BASE_URL=http://gpu-box:9099/v1
API_KEY=
LLM_MODEL=qwen-3.5-2b
IMAGE_MODEL=qwen-image-2.1

# Google OAuth. GG_CALLBACK_URL phải trùng "Authorized redirect URI" trong Google Cloud Console;
# APP_ORIGIN mặc định lấy theo origin của URL này.
GG_CALLBACK_URL=https://chat.naot.me/auth/gg/callback
GG_CLIENT_ID=
GG_CLIENT_SECRET=

# Email (cách nhau bằng dấu phẩy): ADMIN_EMAILS → admin + active ngay; ALLOWED_EMAILS → active ngay.
ADMIN_EMAILS=
ALLOWED_EMAILS=

# Tuỳ chọn (giá trị mặc định)
# APP_ORIGIN=https://chat.naot.me
# SESSION_TTL=720h
# LLM_CONTEXT_TOKENS=32768
# LLM_MAX_OUTPUT_TOKENS=4096
# LLM_REASONING_EFFORT=low          # none = tắt thinking
# LLM_VISION=true
# VISION_MAX_PX=1024
# LLM_MAX_CONCURRENCY=2
# IMAGE_MAX_CONCURRENCY=1
# IMAGE_TIMEOUT=180s
# MAX_UPLOAD_MB=20
# DOC_MAX_CHARS=24000
# MAX_MESSAGE_CHARS=16000
# STATS_TZ=Asia/Ho_Chi_Minh
