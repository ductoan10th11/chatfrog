# Copy thành .env (chmod 600). Xem docs/SPEC.md §9.

APP_ORIGIN=https://chat.naot.me

# db (chatfrog-db, 127.0.0.1:9261)
MONGO_INITDB_ROOT_USERNAME=chatfrog
MONGO_INITDB_ROOT_PASSWORD=change-me

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=
ALLOWED_EMAILS=
SESSION_TTL=720h

# LLM (OpenAI-compatible, qua Tailscale)
LLM_BASE_URL=http://gpu-box:8001/v1
LLM_API_KEY=none
LLM_MODEL=qwen3.5-4b
LLM_CONTEXT_TOKENS=32768
LLM_MAX_OUTPUT_TOKENS=4096
LLM_VISION=true
VISION_MAX_PX=1024
LLM_MAX_CONCURRENCY=2

# Image (OpenAI-compatible, b64_json)
IMAGE_BASE_URL=http://gpu-box:8002/v1
IMAGE_API_KEY=none
IMAGE_MODEL=flux.2-klein-4b
IMAGE_MAX_CONCURRENCY=1
IMAGE_TIMEOUT=180s

MAX_TOOL_ROUNDS=3
MAX_UPLOAD_MB=20
DOC_MAX_CHARS=24000
MAX_MESSAGE_CHARS=16000
